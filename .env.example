# Local dev configuration (bun run dev + ./scripts/dev-setup.sh)
#
# For Docker Compose deployments, use deploy/docker/.env.example instead --
# it uses DB_USER/DB_PASS/DB_NAME which compose interpolates into both the
# postgres container and the app's DATABASE_URL.

# =============================================================================
# Database
# =============================================================================
# Full connection string (takes precedence over individual DB_* vars)
DATABASE_URL=postgresql://djllama:djllama@localhost:5432/djllama

# Or set individual vars (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=djllama
# DB_PASS=djllama
# DB_NAME=djllama
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_SSL_MODE=disable          # disable, require, or no-verify
#   require   = TLS with full certificate verification (stricter than libpq's
#               "require", which encrypts without verifying).
#   no-verify = TLS without certificate verification (self-signed setups).

# =============================================================================
# Server
# =============================================================================
PORT=3000

# Exact public origin (scheme + host + optional port; no path or trailing slash).
# Required behind a reverse proxy/TLS terminator. Controls CORS,
# the CSRF trust origin, and whether browser session cookies use Secure.
# ALLOWED_ORIGIN=https://dj-llama.example.com

# Browser cookies default to Secure in production, even when the backend request
# arrives over HTTP behind a TLS-terminating proxy. Set true ONLY for an
# intentional direct-HTTP production deployment; it drops Secure only when the
# public origin is http:. Pair it with a matching http:// ALLOWED_ORIGIN.
# Direct HTTP exposes the session cookie to network interception.
# DJLLAMA_ALLOW_INSECURE_COOKIES=false

# Other sites allowed to show DJ Llama inside a frame (e.g. a car-dashboard
# launcher), space- or comma-separated origins. Unset = X-Frame-Options: DENY.
# When framed, Plex sign-in moves the whole tab to Plex and comes back.
# DJLLAMA_FRAME_ANCESTORS=https://launcher.example.com

# Deprecated shared bearer token: non-admin userId=1 compatibility.
# Normal browser auth uses per-user HttpOnly cookies; API clients can use
# per-user bearer sessions returned by POST /api/v1/auth/login.
# DJLLAMA_AUTH_TOKEN=


# Encrypt API keys and tokens at rest in the database (AES-256-GCM).
# Any string works as a key -- derived via HKDF internally.
# Once set, existing plaintext values are encrypted on next write.
# DJLLAMA_ENCRYPTION_KEY=

# =============================================================================
# Services (global defaults -- seed the settings table when null)
# =============================================================================
# These are optional env var fallbacks. You can also configure everything
# through the web UI on first boot. Env vars are useful for zero-touch
# Docker deployments that skip the setup wizard.

# Lidarr (optional -- without it, DJ Llama runs in discovery-only mode)
# LIDARR_URL=http://localhost:8686
# LIDARR_API_KEY=your-lidarr-api-key
# SKIP_TLS_VERIFY=false

# AI provider (required)
# AI_PROVIDER=openai        # openai, anthropic, gemini, ollama, or openai-compatible
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your-ai-api-key
# AI_BASE_URL=              # optional, for ollama or compatible APIs (threaded to Anthropic/OpenAI SDKs too)
# DJLLAMA_AI_TIMEOUT_SECONDS=  # optional; overrides AI request and OpenAI-compatible connection-test timeouts

# =============================================================================
# Per-user connectors (configured via web UI only -- no env vars)
# =============================================================================
# Plex is configured per-user through Settings > Connections in the web UI
# (URL + token). Spotify and Deezer playlist import need no auth at all
# (public APIs) -- paste a link on the Playlists page.

# =============================================================================
# Backup & Upgrade Safety
# =============================================================================
# DJLLAMA_BACKUP_DIR=./backups          # Directory for auto-backups (default: ./backups)
# DJLLAMA_AUTO_BACKUP=true              # Auto-backup before migrations (default: true, set to false to disable)

# =============================================================================
# Notifications
# =============================================================================
# Webhook URL for scan completion notifications.
# Discord gets embed formatting; other public HTTPS endpoints receive raw DJ Llama JSON.
# Plain HTTP is accepted for compatibility but exposes payload data in transit.
# For Discord threads, append ?thread_id=YOUR_THREAD_ID to the webhook URL.
# WEBHOOK_URL=
