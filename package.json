{
  "name": "dj-llama",
  "version": "2026.10.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:web": "vite",
    "build": "vite build && bun build src/index.ts --outdir dist/server --target bun --external @electric-sql/pglite && bun build scripts/rotate-encryption-key.ts --outfile dist/scripts/rotate-encryption-key.js --target bun --external @electric-sql/pglite && bun build scripts/prepare-rollback-backup.ts --outfile dist/scripts/prepare-rollback-backup.js --target bun --external @electric-sql/pglite",
    "start": "bun dist/server/index.js",
    "check:docker-identity": "./scripts/check-docker-identity.sh",
    "test": "vitest run --maxWorkers=4",
    "test:api-routes": "vitest run tests/api-routes/",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "overrides": {
    "esbuild": "^0.28.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "0.5.9",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "openai": "^6.49.0",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.1",
    "pg": "^8.23.1",
    "shazam-api": "^0.3.0",
    "zod": "^4.6.7"
  }
}
