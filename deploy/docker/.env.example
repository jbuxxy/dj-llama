# Docker Compose configuration (deploy/docker/docker-compose.yml)
#
# Copy to .env (in this directory) and fill in your values.
# For local dev without Docker, use the root .env.example instead.
#
# All service vars are optional here -- you can configure them via the web UI
# instead. If all required vars are set, setup completes automatically on boot.

# =============================================================================
# Database
# =============================================================================
# Default: embedded PGlite (no config needed). Data lives in the `data` volume (DB_PATH=/app/data).
# To use an external PostgreSQL instead, set DB_HOST (and DB_USER/DB_NAME/DB_PASS) or DATABASE_URL.
# The default compose stack reads the external database password from
# ./secrets/postgres_password. Use DB_PASS only with a custom env-var-only override.
# DB_HOST=postgres
# DB_USER=djllama
# DB_NAME=djllama
# DB_PASS=
# DB_PASS_FILE=/run/secrets/postgres_password
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_SSL_MODE=disable          # disable, require, or no-verify
#   require   = TLS with full certificate verification (stricter than libpq's
#               "require", which encrypts without verifying).
#   no-verify = TLS without certificate verification (self-signed setups).

# =============================================================================
# Server
# =============================================================================
PORT=3000
# Exact public origin; required behind a reverse proxy/TLS terminator.
# Controls CORS, CSRF origin checks, and the session cookie Secure flag.
# Use scheme + host + optional port only, with no path or trailing slash.
# ALLOWED_ORIGIN=https://dj-llama.example.com

# Browser cookies default to Secure in production, even when the backend request
# arrives over HTTP behind a TLS-terminating proxy. Set true ONLY for an
# intentional direct-HTTP production deployment; it drops Secure only when the
# public origin is http:. Pair it with a matching http:// ALLOWED_ORIGIN.
# Direct HTTP exposes the session cookie to network interception.
# DJLLAMA_ALLOW_INSECURE_COOKIES=false

# Other sites allowed to show DJ Llama inside a frame (e.g. a car-dashboard
# launcher), space- or comma-separated origins. Unset = X-Frame-Options: DENY.
# When framed, Plex sign-in moves the whole tab to Plex and comes back.
# DJLLAMA_FRAME_ANCESTORS=https://launcher.example.com

# =============================================================================
# Auth
# =============================================================================
# DJLLAMA_AUTH_TOKEN=         # deprecated non-admin userId=1 compatibility token
# DJLLAMA_ENCRYPTION_KEY=     # AES-256-GCM encryption for API keys at rest

# =============================================================================
# Notifications
# =============================================================================
# WEBHOOK_URL=               # Discord HTTPS webhook or public HTTPS endpoint accepting DJ Llama JSON

# =============================================================================
# Lidarr (optional -- without it, DJ Llama runs in discovery-only mode)
# =============================================================================
# LIDARR_URL=http://lidarr:8686
# LIDARR_API_KEY=
# SKIP_TLS_VERIFY=false

# =============================================================================
# Listening sources (optional for setup, recommended before running discovery)
# =============================================================================
# LISTENBRAINZ_USERNAME=
# LISTENBRAINZ_TOKEN=

# LASTFM_USERNAME=
# LASTFM_API_KEY=

# =============================================================================
# Deezer OAuth (optional -- enables Deezer favorites, followed, Flow, playlists)
# =============================================================================
# DEEZER_APP_ID=
# DEEZER_APP_SECRET=

# =============================================================================
# Spotify OAuth (optional -- lets each user connect their own Spotify account)
# =============================================================================
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# =============================================================================
# AI provider
# =============================================================================
# AI_PROVIDER=openai         # openai, anthropic, gemini, ollama, or openai-compatible
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=               # optional, for ollama or compatible APIs (threaded to Anthropic/OpenAI SDKs too)
# DJLLAMA_AI_TIMEOUT_SECONDS=   # optional; overrides AI request and OpenAI-compatible connection-test timeouts
